{
	"name": "@comapeo/media-server",
	"version": "0.0.0",
	"description": "Serves CoMapeo project blobs and category icons over HTTP, rendering icon SVGs to PNG",
	"keywords": [],
	"license": "MIT",
	"author": "Awana Digital",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/digidem/comapeo-media-server.git"
	},
	"homepage": "https://github.com/digidem/comapeo-media-server#readme",
	"bugs": {
		"url": "https://github.com/digidem/comapeo-media-server/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./urls.js": {
			"types": "./dist/urls.d.ts",
			"default": "./dist/urls.js"
		},
		"./errors.js": {
			"types": "./dist/errors.d.ts",
			"default": "./dist/errors.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"sideEffects": false,
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"prepack": "npm run build",
		"prepare": "husky",
		"format": "prettier --write .",
		"test": "run-s test:types test:lint test:unused test:unit",
		"test:types": "tsc",
		"test:lint": "eslint",
		"test:unused": "knip",
		"test:unit": "node --test \"test/**/*.test.ts\"",
		"coverage": "c8 --reporter=lcov --reporter=text node --test \"test/**/*.test.ts\"",
		"fixtures:render-hashes": "node scripts/generate-render-hashes.ts",
		"check:pkg": "npm run build && publint && attw --pack --profile esm-only",
		"changeset": "changeset",
		"release": "changeset publish"
	},
	"prettier": {
		"semi": false,
		"singleQuote": true,
		"useTabs": true,
		"importOrder": [
			"^node:",
			"<THIRD_PARTY_MODULES>",
			"^[./]"
		],
		"importOrderSeparation": true,
		"plugins": [
			"@trivago/prettier-plugin-sort-imports"
		],
		"overrides": [
			{
				"files": "*.md",
				"options": {
					"useTabs": false
				}
			}
		]
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,mts,cts}": "eslint --cache --fix",
		"*": "prettier --write --ignore-unknown"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@comapeo/core": "^7.6.1",
		"@comapeo/crypto": "^2.0.0",
		"@eslint/js": "^10.0.1",
		"@mapeo/default-config": "^6.0.0",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^22.20.5",
		"@types/range-parser": "^1.2.7",
		"@types/streamx": "^2.9.5",
		"c8": "^12.0.0",
		"comapeocat": "^1.2.0",
		"eslint": "^10.13.0",
		"fastify": "^4.29.1",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"knip": "^6.42.1",
		"lint-staged": "^17.6.0",
		"npm-run-all2": "^9.0.4",
		"prettier": "^3.9.10",
		"publint": "^0.3.25",
		"rimraf": "^6.1.3",
		"streamx": "^2.28.1",
		"typescript": "~6.0",
		"typescript-eslint": "^8.72.0"
	},
	"dependencies": {
		"@comapeo/node-server": "^1.0.0",
		"@comapeo/resvg": "^1.0.1",
		"custom-error-creator": "^1.4.0",
		"itty-router": "^5.0.24",
		"magic-bytes.js": "^1.13.1",
		"range-parser": "^1.3.0"
	}
}
